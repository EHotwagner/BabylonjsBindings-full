{
  "name": "babylonjsbindings-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "26.5.0",
    "npm": "12.0.1"
  },
  "dependencies": {
    "@babylonjs/core": "9.19.0",
    "@babylonjs/loaders": "9.19.0"
  },
  "devDependencies": {
    "@glutinum/cli": "0.13.0",
    "ajv": "8.20.0",
    "babylonjs": "9.19.0",
    "babylonjs-loaders": "9.19.0",
    "ts2fable": "0.9.0-build.738",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@glutinum/cli": {
      "typescript": "5.2.2"
    },
    "ts2fable": {
      "typescript": "5.1.6"
    }
  },
  "scripts": {
    "test": "npm run test:bindings",
    "test:bindings:inventory": "node --test tests/bindings/inventory.test.mjs tests/bindings/runtime-imports.test.mjs",
    "test:bindings:cross-runtime": "node --test tests/bindings/cross-runtime.test.mjs",
    "test:bindings": "node scripts/run-binding-tests.mjs",
    "build:village": "dotnet fable examples/VillageStarter/VillageStarter.fsproj --outDir examples/VillageStarter/dist --noCache",
    "test:village-browser": "node scripts/test-village-browser.mjs",
    "build": "bash build.sh",
    "lock:declarations": "node scripts/lock-declarations.mjs --write",
    "check:drift": "node scripts/lock-declarations.mjs --check",
    "coverage:generate": "node --max-old-space-size=8192 scripts/generate-coverage.mjs",
    "coverage:check": "node --max-old-space-size=8192 scripts/generate-coverage.mjs --check",
    "coverage:require-complete": "node --max-old-space-size=8192 scripts/generate-coverage.mjs --check --require-complete",
    "analysis:generate": "node scripts/generate-analysis-infrastructure.mjs",
    "analysis:check": "node scripts/generate-analysis-infrastructure.mjs --check",
    "analysis:determinism": "node scripts/check-analysis-determinism.mjs",
    "analysis:test": "node --test scripts/test-analysis-infrastructure.mjs",
    "analysis:test:trx": "node scripts/run-analysis-tests.mjs reports/m0-analysis.trx",
    "generate:m2-finite-maps": "node scripts/generate-m2-finite-dependent-maps.mjs",
    "check:m2-finite-maps": "node scripts/generate-m2-finite-dependent-maps.mjs --check",
    "test:m2-negative": "node scripts/check-m2-negative-fixtures.mjs",
    "test:m2-fable": "dotnet fable tests/BabylonjsBindings.CompileTests/BabylonjsBindings.CompileTests.fsproj --outDir runtime/m2-dist --noCache",
    "test:m2-imports": "node scripts/check-m2-emitted-imports.mjs",
    "test:m2-node": "node runtime/node/m2-smoke.mjs",
    "test:m2-browser": "node scripts/test-m2-browser.mjs",
    "test:m2-clean-consumer": "node scripts/test-m2-clean-consumer.mjs",
    "test:m2:trx": "node scripts/run-m2-tests.mjs reports/m2-finite-dependent-maps.trx",
    "scan:m3-arity": "node scripts/scan-m3-callable-arity.mjs --check",
    "check:m3-reviewed-projection": "node scripts/check-m3-reviewed-projection.mjs",
    "test:m3-negative": "node scripts/check-m3-negative-fixtures.mjs",
    "test:m3-fable": "dotnet fable tests/BabylonjsBindings.CompileTests/BabylonjsBindings.CompileTests.fsproj --outDir runtime/m3-dist --noCache",
    "test:m3-imports": "node scripts/check-m3-emitted-imports.mjs",
    "test:m3-node": "node runtime/node/m3-smoke.mjs",
    "test:m3-browser": "node scripts/test-m3-browser.mjs",
    "test:m3-clean-consumer": "node scripts/test-m3-clean-consumer.mjs",
    "test:m3:trx": "node scripts/run-m3-tests.mjs reports/m3-higher-order-runtime-apis.trx",
    "generate:m4-type-core": "node scripts/generate-m4-type-function-core.mjs",
    "check:m4-type-core": "node scripts/generate-m4-type-function-core.mjs --check",
    "generate:m5-gltf-namespaces": "node scripts/generate-m5-gltf-namespaces.mjs",
    "check:m5-gltf-namespaces": "node scripts/generate-m5-gltf-namespaces.mjs --check",
    "test:m4-negative": "node scripts/check-m4-negative-fixture.mjs",
    "test:m5-node": "node runtime/node/m5-gltf-namespaces.mjs",
    "test:m6-emitted": "node scripts/check-m6-emitted.mjs",
    "test:m6-clean-consumer": "node scripts/test-m6-clean-consumer.mjs",
    "test:m6-release": "node scripts/run-m6-release.mjs",
    "check:m0-sdd-readiness": "bash scripts/check-m0-sdd-readiness.sh",
    "check:m1-sdd-readiness": "bash scripts/check-m1-sdd-readiness.sh",
    "check:m2-sdd-readiness": "bash scripts/check-m2-sdd-readiness.sh",
    "check:m3-sdd-readiness": "bash scripts/check-m3-sdd-readiness.sh",
    "check:m1-exact-projections": "node scripts/check-m1-exact-projections.mjs",
    "test:m1-clean-consumer": "node scripts/test-m1-clean-consumer.mjs",
    "test:m1:trx": "node scripts/run-m1-tests.mjs reports/m1-exact-projections.trx",
    "test:candidate-compile": "node scripts/test-candidate-compile.mjs",
    "test:candidate-fable": "dotnet fable generated-candidates/runtime/BabylonjsBindings.CandidateRuntime.fsproj --outDir generated-candidates/runtime/dist --noCache",
    "test:candidate-imports": "node scripts/check-emitted-imports.mjs && node scripts/check-class-imports.mjs && node scripts/check-function-imports.mjs && node scripts/check-variable-imports.mjs",
    "test:candidate-runtime": "node generated-candidates/runtime/dist/Program.js",
    "test:candidate-browser": "node scripts/test-candidate-browser.mjs",
    "test:candidate-consumer": "node scripts/test-candidate-consumer.mjs",
    "test:candidate-prepared": "npm run test:candidate-compile && npm run test:candidate-fable && npm run test:candidate-imports && npm run test:candidate-runtime && npm run test:candidate-browser && npm run test:candidate-consumer",
    "test:candidate": "npm run generate:candidate && npm run generate:reviewed-simple-proposals && npm run test:candidate-prepared",
    "test:runtime": "node runtime/node/smoke.mjs",
    "generate:candidate": "node --max-old-space-size=12288 scripts/generate-candidate.mjs",
    "generate:enum-proposal": "node --max-old-space-size=8192 scripts/generate-enum-proposal.mjs",
    "check:enum-proposal": "node --max-old-space-size=8192 scripts/generate-enum-proposal.mjs --check",
    "generate:string-enum-proposal": "node --max-old-space-size=8192 scripts/generate-string-enum-proposal.mjs",
    "check:string-enum-proposal": "node --max-old-space-size=8192 scripts/generate-string-enum-proposal.mjs --check",
    "generate:simple-object-proposal": "node --max-old-space-size=8192 scripts/generate-simple-object-proposal.mjs",
    "check:simple-object-proposal": "node --max-old-space-size=8192 scripts/generate-simple-object-proposal.mjs --check",
    "generate:simple-alias-proposal": "node --max-old-space-size=8192 scripts/generate-simple-alias-proposal.mjs",
    "check:simple-alias-proposal": "node --max-old-space-size=8192 scripts/generate-simple-alias-proposal.mjs --check",
    "generate:simple-interface-proposal": "node --max-old-space-size=8192 scripts/generate-simple-interface-proposal.mjs",
    "check:simple-interface-proposal": "node --max-old-space-size=8192 scripts/generate-simple-interface-proposal.mjs --check",
    "generate:simple-class-proposal": "node --max-old-space-size=8192 scripts/generate-simple-class-proposal.mjs",
    "check:simple-class-proposal": "node --max-old-space-size=8192 scripts/generate-simple-class-proposal.mjs --check",
    "generate:simple-types-proposal": "node scripts/generate-simple-types-proposal.mjs",
    "check:simple-types-proposal": "node scripts/generate-simple-types-proposal.mjs --check",
    "project:simple-types-maintained": "node scripts/generate-simple-types-proposal.mjs --maintained",
    "check:simple-types-maintained": "node scripts/generate-simple-types-proposal.mjs --maintained --check",
    "generate:simple-function-proposal": "node --max-old-space-size=8192 scripts/generate-simple-function-proposal.mjs",
    "check:simple-function-proposal": "node --max-old-space-size=8192 scripts/generate-simple-function-proposal.mjs --check",
    "generate:simple-variable-proposal": "node --max-old-space-size=8192 scripts/generate-simple-variable-proposal.mjs",
    "check:simple-variable-proposal": "node --max-old-space-size=8192 scripts/generate-simple-variable-proposal.mjs --check",
    "generate:reviewed-simple-proposals": "node scripts/generate-reviewed-simple-proposals.mjs",
    "generate:promotion-batch": "node scripts/generate-promotion-batch.mjs",
    "check:promotion-batch": "node scripts/generate-promotion-batch.mjs --check",
    "generate:promotion-preview": "node scripts/generate-promotion-preview.mjs",
    "test:promotion-preview": "node scripts/generate-promotion-preview.mjs && dotnet restore generated-candidates/promotion-batch/BabylonjsBindings.PromotionPreview.fsproj --locked-mode && dotnet build generated-candidates/promotion-batch/BabylonjsBindings.PromotionPreview.fsproj --no-restore --nologo -v:minimal",
    "promote:reviewed-batch": "node scripts/promote-reviewed-batch.mjs --apply-reviewed && node scripts/generate-simple-types-proposal.mjs --maintained",
    "test:browser": "chromium --headless --no-sandbox --disable-gpu --virtual-time-budget=3000 --dump-dom http://127.0.0.1:4173/runtime/browser/",
    "test:lifecycle": "bash scripts/run-sdd-lifecycle.sh reports/bindings.junit.xml",
    "doctor": "node scripts/doctor.mjs"
  }
}
