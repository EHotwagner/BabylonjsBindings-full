{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "const": "declaration-lock.json" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["declarationIdentity", "typeScriptExpression", "fsharpSymbol", "status", "evidence"],
        "properties": {
          "declarationIdentity": { "type": "string", "pattern": "^[^|]+\\|[^|]+\\|[^|]+$" },
          "typeScriptExpression": { "type": "string", "minLength": 1 },
          "fsharpSymbol": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$" },
          "status": { "enum": ["reviewed", "blocked"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
